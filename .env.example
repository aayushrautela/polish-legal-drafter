MODEL_ID=unsloth/Qwen3.5-2B
MODEL_AUTO_CLASS=AutoModelForImageTextToText
MODEL_LOAD_IN_4BIT=false
MODEL_DTYPE=float16
INFERENCE_ENGINE=vllm
HUGGINGFACE_HUB_TOKEN=
HF_TOKEN=

# --- Distillation teacher / checker (OpenAI-compatible API) ---
# Teacher generates evidence_reports + draft answers; Checker validates them.
# Point *_BASE_URL at any OpenAI-compatible endpoint (OpenAI, Azure, vLLM, ...).
# TEACHER_API_KEY falls back to OPENAI_API_KEY if unset.
TEACHER_MODEL=gpt-5
TEACHER_BASE_URL=
TEACHER_API_KEY=
TEACHER_TIMEOUT=120
TEACHER_MAX_RETRIES=5
TEACHER_TEMPERATURE=0.2
TEACHER_MAX_TOKENS=
TEACHER_TOP_P=
TEACHER_EXTRA_HEADERS=
TEACHER_EXTRA_BODY=

CHECKER_MODEL=gpt-5-mini
CHECKER_BASE_URL=
CHECKER_API_KEY=
CHECKER_TIMEOUT=120
CHECKER_MAX_RETRIES=5
CHECKER_TEMPERATURE=0.0
CHECKER_MAX_TOKENS=
CHECKER_TOP_P=
CHECKER_EXTRA_HEADERS=
CHECKER_EXTRA_BODY=

# Sampling-parameter compatibility:
# Newer Claude models (Sonnet 5, Opus 4.7/4.8/5, Fable/Mythos 5) reject non-default
# sampling params (temperature/top_p/top_k) with HTTP 400 over any OpenAI-compatible
# endpoint; Anthropic's guidance is to omit them. Models are reached through router
# aliases here (the real model is invisible to the client), so the choice is yours:
# set the matching *_SAMPLING knobs to "off" to stop sending them. Values: on|off.
# LLM_SAMPLING=off disables for every role at once.
TEACHER_SAMPLING=on
CHECKER_SAMPLING=on

OPENAI_API_KEY=

# --- eval100 blind pairwise judge (OpenAI-compatible router) ---
# Both judges are routed through one endpoint; model names select the judge.
# The pipeline appends one row per verdict and resumes interrupted runs.
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL_A=
JUDGE_MODEL_B=
JUDGE_TIMEOUT=300
JUDGE_WATCHDOG=600
JUDGE_MAX_TOKENS=2048
JUDGE_TEMPERATURE=0.0
JUDGE_SEED=
# See TEACHER_SAMPLING above: set JUDGE_SAMPLING=off when judges are newer Claude models.
JUDGE_SAMPLING=on
# Paths / inputs (CLI flags override these when both are given)
JUDGE_QUESTIONS=outputs/eval100/eval100_questions.jsonl
JUDGE_BASE_RESULTS=outputs/eval100/eval100_base.jsonl
JUDGE_LORA250_RESULTS=outputs/eval100/eval100_lora250.jsonl
JUDGE_FINAL_RESULTS=outputs/eval100/eval100_final.jsonl
JUDGE_PREPARE_OUT=outputs/eval100/judge_inputs.jsonl
JUDGE_QDRANT_PATH=.rag/qdrant/qdrant
# Run tunables (CLI flags override these when both are given)
JUDGE_INPUTS=outputs/eval100/judge_inputs.jsonl
JUDGE_OUT_DIR=outputs/judge_runs
JUDGE_RUN_ID=
JUDGE_TRIALS=2
JUDGE_WORKERS=5
JUDGE_RETRIES=2
JUDGE_RETRY_ERRORS=
JUDGE_JUDGES=both
JUDGE_PROMPT_VERSION=pl-contract-pairwise-v3
JUDGE_BREAKER=1

# --- RAG retrieval service (bare metal) ---
# Generation pipelines (scripts/question_gen, eval) call the retrieval tools
# over HTTP. Serve it with scripts/rag/server.py, then point pipelines here.
# RAG server settings (see scripts/rag/server.py docstring for the full list):
RETRIEVAL_ENDPOINT=http://127.0.0.1:10100
RAG_HOST=0.0.0.0
RAG_PORT=10100
RAG_QDRANT_PATH=.rag/qdrant
RAG_COLLECTION=legal_corpus

# --- Anthropic compat layer (optional) ---
# Route a role's chat traffic through Anthropic's native /v1/messages API via
# the in-process OpenAI-shape translator (src/legal_drafter/compat.py). Set
# <ROLE>_COMPAT (or global LLM_COMPAT) to "anthropic" for the roles that need
# it (teacher/checker/judge). Endpoint + key default to the official API and
# fall back to the role's own BASE_URL/API_KEY values if unset.
#LLM_COMPAT=
#TEACHER_COMPAT=anthropic
#ANTHROPIC_BASE_URL=https://api.anthropic.com
#ANTHROPIC_API_KEY=
# Thinking trace handling: "adaptive" requests a summarized thinking block on
# every response (surfaced as reasoning_content); "off" omits the parameter.
#ANTHROPIC_COMPAT_THINKING=adaptive
# Default max_tokens when a request does not carry one.
#ANTHROPIC_COMPAT_MAX_TOKENS=8192
