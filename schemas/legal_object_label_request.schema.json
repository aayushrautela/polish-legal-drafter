{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/legal-object-label-request.schema.json",
  "title": "Legal Object Label Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": "legal_object_v0"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "language", "text", "source_type", "expected_use"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "language": {"type": "string", "minLength": 2},
          "text": {"type": "string", "minLength": 1},
          "source_type": {"type": "string", "minLength": 1},
          "source_url": {"type": ["string", "null"]},
          "doc_type": {"type": ["string", "null"]},
          "legal_area": {"type": "array", "items": {"type": "string"}},
          "expected_use": {"type": "string"},
          "metadata": {"type": "object"}
        }
      }
    }
  }
}
